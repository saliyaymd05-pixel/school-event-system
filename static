<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventSchool - School Event Management System</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Top Bar / Auth Header -->
  <div class="top-announcement">
    <div class="announcement-text">
      <i class="fa-solid fa-school"></i> <strong>EventSchool Platform:</strong> School Event Management System
    </div>
    <div class="role-selector" id="topAuthArea">
      <button class="btn btn-sm btn-primary" onclick="openModal('headLoginModal')"><i class="fa-solid fa-user-shield"></i> Event Head Login</button>
    </div>
  </div>

  <!-- Main Navigation Header -->
  <header class="main-header">
    <div class="header-container">
      <a href="#home" class="brand-logo">
        <div class="logo-icon"><i class="fa-solid fa-graduation-cap"></i></div>
        <span>EventSchool</span>
      </a>

      <nav class="nav-links" id="navMenu">
        <a href="#home" class="nav-link active">Home</a>
        <a href="#events" class="nav-link">Events</a>
        <a href="#categories" class="nav-link">Categories</a>
        <a href="#schedule" class="nav-link">Schedule</a>
        <a href="#gallery" class="nav-link">Gallery</a>
        <a href="#dashboard" class="nav-link btn-dash"><i class="fa-solid fa-gauge"></i> Dashboard</a>
      </nav>

      <div class="header-actions">
        <a href="#events" class="btn btn-primary">Explore Events</a>
        <button class="hamburger-btn" onclick="toggleMobileMenu()">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section id="home" class="hero-section">
    <div class="hero-container">
      <div class="hero-content">
        <span class="badge badge-accent"><i class="fa-solid fa-star"></i> Premier School Management</span>
        <h1 class="hero-title">Every Event Begins with a <span>Great Plan.</span></h1>
        <p class="hero-subtitle">Discover, organize, and celebrate unforgettable school events, competitions, and parent-teacher meetings in one place.</p>
        
        <div class="hero-buttons">
          <a href="#events" class="btn btn-primary btn-lg"><i class="fa-solid fa-compass"></i> Explore Events</a>
          <button onclick="openModal('createEventModal')" class="btn btn-outline btn-lg"><i class="fa-solid fa-plus-circle"></i> Create Event</button>
        </div>
      </div>

      <div class="hero-visual">
        <div class="image-grid">
          <img src="https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=1000&q=80" alt="School Science Fair" class="grid-img img-main">
          <img src="https://images.unsplash.com/photo-1475721027785-f74eccf877e2?auto=format&fit=crop&w=600&q=80" alt="Cultural Stage" class="grid-img img-sub-1">
          <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=600&q=80" alt="Sports Day" class="grid-img img-sub-2">
        </div>
      </div>
    </div>
  </section>

  <!-- Events Section -->
  <section id="events" class="section-container">
    <div class="section-header text-center">
      <span class="section-subtitle">School Activities</span>
      <h2 class="section-title">Discover School Events</h2>
      <p class="section-desc">Search through science fairs, athletic meets, workshops, and parent-teacher gatherings.</p>
    </div>

    <div class="search-filter-card">
      <div class="filter-group flex-2">
        <label><i class="fa-solid fa-magnifying-glass"></i> Search</label>
        <input type="text" id="searchInput" placeholder="Search event title or venue..." oninput="filterEvents()">
      </div>
      <div class="filter-group">
        <label><i class="fa-solid fa-list"></i> Category</label>
        <select id="categoryFilter" onchange="filterEvents()">
          <option value="All">All Categories</option>
          <option value="Academic">Academic</option>
          <option value="Cultural">Cultural</option>
          <option value="Sports">Sports</option>
          <option value="Workshops">Workshops</option>
          <option value="Parent-Teacher Meets">Parent-Teacher Meets</option>
        </select>
      </div>
      <div class="filter-actions">
        <button class="btn btn-secondary" onclick="resetFilters()"><i class="fa-solid fa-rotate-left"></i> Reset</button>
      </div>
    </div>

    <div class="events-grid" id="eventsGrid"></div>
  </section>

  <!-- Categories Section -->
  <section id="categories" class="section-container bg-light">
    <div class="section-header text-center">
      <span class="section-subtitle">Categorized Activities</span>
      <h2 class="section-title">School Event Categories</h2>
    </div>

    <div class="categories-grid">
      <div class="category-card" onclick="filterByCategory('Academic')">
        <div class="cat-icon"><i class="fa-solid fa-graduation-cap"></i></div>
        <h3>🎓 Academic Events</h3>
        <p>Science fairs, spelling bees, math olympiads, and exhibitions.</p>
      </div>
      <div class="category-card" onclick="filterByCategory('Cultural')">
        <div class="cat-icon"><i class="fa-solid fa-masks-theater"></i></div>
        <h3>🎨 Cultural Events</h3>
        <p>Annual school play, music concerts, dance, and art expos.</p>
      </div>
      <div class="category-card" onclick="filterByCategory('Sports')">
        <div class="cat-icon"><i class="fa-solid fa-trophy"></i></div>
        <h3>🏆 Sports Events</h3>
        <p>Inter-house athletics, soccer tournaments, and sports day.</p>
      </div>
      <div class="category-card" onclick="filterByCategory('Workshops')">
        <div class="cat-icon"><i class="fa-solid fa-laptop-code"></i></div>
        <h3>📢 Workshops</h3>
        <p>Robotics bootcamps, coding workshops, and safety sessions.</p>
      </div>
    </div>
  </section>

  <!-- Schedule Section -->
  <section id="schedule" class="section-container">
    <div class="section-header text-center">
      <span class="section-subtitle">Timelines</span>
      <h2 class="section-title">School Event Schedule</h2>
    </div>

    <div class="timeline-wrapper">
      <div class="timeline-item">
        <div class="time-badge">09:00 AM - 04:00 PM</div>
        <div class="timeline-content">
          <span class="badge badge-orange">Academic</span>
          <h3>Annual Science Fair 2026</h3>
          <p><i class="fa-solid fa-location-dot"></i> School Auditorium</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="time-badge">08:00 AM - 05:00 PM</div>
        <div class="timeline-content">
          <span class="badge badge-orange">Sports</span>
          <h3>Annual Sports Day Athletics</h3>
          <p><i class="fa-solid fa-location-dot"></i> School Ground</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dashboard Section (Event Head Controls) -->
  <section id="dashboard" class="section-container dashboard-wrapper">
    <div class="section-header">
      <span class="section-subtitle">Management Portal</span>
      <h2 class="section-title"><i class="fa-solid fa-sliders"></i> Event Head Student Manager</h2>
    </div>

    <div class="dashboard-layout" style="grid-template-columns: 1fr;">
      <main class="dash-content">
        <div id="headWelcomeBanner" style="background:var(--secondary); padding:16px 20px; border-radius:12px; margin-bottom:20px; font-weight:600; color:var(--primary-hover);">
          <i class="fa-solid fa-circle-info"></i> Please log in via the <strong>Event Head Login</strong> button at the top to view and manage students registered for your assigned event.
        </div>

        <div class="panel-header">
          <h3 id="tableTitleHeading">Registered Students List</h3>
        </div>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Student Name</th>
                <th>Event Title</th>
                <th>Type</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th id="actionHeaderCol" style="display:none;">Event Head Actions (Delete / Disqualify)</th>
              </tr>
            </thead>
            <tbody id="registrationsTableBody"></tbody>
          </table>
        </div>
      </main>
    </div>
  </section>

  <!-- Gallery Section -->
  <section id="gallery" class="section-container bg-light">
    <div class="section-header text-center">
      <span class="section-subtitle">School Memories</span>
      <h2 class="section-title">Photo Gallery</h2>
    </div>

    <div class="gallery-grid">
      <div class="gallery-card">
        <img src="https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=1000&q=80" alt="Science Fair">
        <div class="gallery-overlay"><span>Science Exhibition</span></div>
      </div>
      <div class="gallery-card">
        <img src="https://images.unsplash.com/photo-1475721027785-f74eccf877e2?auto=format&fit=crop&w=600&q=80" alt="Cultural Day">
        <div class="gallery-overlay"><span>Cultural Program</span></div>
      </div>
      <div class="gallery-card">
        <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=600&q=80" alt="Sports Day">
        <div class="gallery-overlay"><span>Athletics Track</span></div>
      </div>
      <div class="gallery-card">
        <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=800&q=80" alt="Robotics Workshop">
        <div class="gallery-overlay"><span>Robotics Workshop</span></div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="main-footer">
    <div class="footer-container" style="display:grid; grid-template-columns: 2fr 1fr 1fr; gap:40px;">
      <div>
        <h3><i class="fa-solid fa-graduation-cap"></i> EventSchool</h3>
        <p style="color:#94A3B8; margin-top:8px;">A unified platform for managing all school events, competitions, schedules, and activities.</p>
      </div>
      <div>
        <h4>Quick Links</h4>
        <ul>
          <li><a href="#home">Home</a></li>
          <li><a href="#events">Events</a></li>
          <li><a href="#dashboard">Dashboard</a></li>
        </ul>
      </div>
      <div>
        <h4>School Office</h4>
        <p style="color:#94A3B8;"><i class="fa-solid fa-envelope"></i> admin@eventschool.edu</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 EventSchool Management System. All rights reserved.</p>
    </div>
  </footer>

  <!-- MODALS -->
  <div id="headLoginModal" class="modal-overlay">
    <div class="modal-card">
      <div class="modal-header">
        <h3>Event Head Login</h3>
        <button class="close-btn" onclick="closeModal('headLoginModal')">&times;</button>
      </div>
      <form onsubmit="handleHeadLogin(event)">
        <div class="form-group">
          <label>Username (e.g. science_head or sports_head)</label>
          <input type="text" id="loginUsername" required placeholder="science_head">
        </div>
        <div class="form-group">
          <label>Password (e.g. science123 or sports123)</label>
          <input type="password" id="loginPassword" required placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Login as Event Head</button>
      </form>
    </div>
  </div>

  <div id="createEventModal" class="modal-overlay">
    <div class="modal-card">
      <div class="modal-header">
        <h3>Create New Event</h3>
        <button class="close-btn" onclick="closeModal('createEventModal')">&times;</button>
      </div>
      <form onsubmit="handleCreateEvent(event)">
        <div class="form-group">
          <label>Event Title</label>
          <input type="text" id="evtTitle" required placeholder="Annual Debate">
        </div>
        <div class="form-row">
          <div class="form-group flex-1">
            <label>Category</label>
            <select id="evtCategory">
              <option value="Academic">Academic</option>
              <option value="Cultural">Cultural</option>
              <option value="Sports">Sports</option>
              <option value="Workshops">Workshops</option>
            </select>
          </div>
          <div class="form-group flex-1">
            <label>Status</label>
            <select id="evtStatus">
              <option value="Open for Registration">Open for Registration</option>
              <option value="Planning">Planning</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group flex-1">
            <label>Date</label>
            <input type="date" id="evtDate" required>
          </div>
          <div class="form-group flex-1">
            <label>Time</label>
            <input type="text" id="evtTime" placeholder="10:00 AM" required>
          </div>
        </div>
        <div class="form-group">
          <label>Venue</label>
          <input type="text" id="evtVenue" placeholder="School Hall" required>
        </div>
        <div class="form-group">
          <label>Image URL</label>
          <input type="text" id="evtImage" required value="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80">
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea id="evtDesc" rows="3" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Create Event</button>
      </form>
    </div>
  </div>

  <div id="registerModal" class="modal-overlay">
    <div class="modal-card">
      <div class="modal-header">
        <h3>Register for Event</h3>
        <button class="close-btn" onclick="closeModal('registerModal')">&times;</button>
      </div>
      <form onsubmit="handleRegistrationSubmit(event)">
        <input type="hidden" id="regEventId">
        <div class="form-group">
          <label>Selected Event</label>
          <input type="text" id="regEventTitle" readonly style="background:#eee;">
        </div>
        <div class="form-group">
          <label>Full Name</label>
          <input type="text" id="regName" required placeholder="Rahul Sharma">
        </div>
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" id="regEmail" required placeholder="rahul@email.com">
        </div>
        <div class="form-row">
          <div class="form-group flex-1">
            <label>Participant Type</label>
            <select id="regType">
              <option value="Student">Student</option>
              <option value="Teacher">Teacher</option>
            </select>
          </div>
          <div class="form-group flex-1">
            <label>Phone Number</label>
            <input type="tel" id="regPhone" required placeholder="+91 9876543210">
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Confirm Registration</button>
      </form>
    </div>
  </div>

  <div id="toast" class="toast-notification">Notification Message</div>
  <script src="script.js"></script>
</body>
</html>
